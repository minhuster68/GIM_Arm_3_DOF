<?xml version="1.0"?>
<robot name="gim_arm">

  <!-- Dummy root link to satisfy KDL (added) -->
  <link name="base_footprint"/>

  <!-- Tạo mặt đất ảo -->
  <link name="world"/>

  <!-- Bắt vít gốc của cánh tay xuống mặt đất ảo -->
  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Fixed joint from dummy root to base_link (added) -->
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0.083 0 0"/>
    <!-- <origin xyz="0 0 0" rpy="0.1 0 0"/> -->
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.27344094303007 0.27938715952061 0.510149299908653" rpy="0 0 0" />
      <mass value="6.66855777151619" />
      <inertia
        ixx="0.292932757999248"
        ixy="2.42532565985983E-05"
        ixz="1.4908094022849E-05"
        iyy="0.157532051318604"
        iyz="-0.0223597784843357"
        izz="0.31549969202859" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/base_link.STL" />
      </geometry>
      <material name="base_link_color">
        <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <link name="shoulder_link">
    <inertial>
      <origin xyz="-0.166448794327975 0.0056887985806402 -0.0172848581490532" rpy="0 0 0" />
      <mass value="0.190732966677201" />
      <inertia
        ixx="0.000205948851297408"
        ixy="-2.38990127172075E-07"
        ixz="7.27163071554151E-05"
        iyy="0.000237074859368272"
        iyz="-8.24496296171646E-07"
        izz="0.000153162765676654" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/shoulder_link.STL" />
      </geometry>
      <material name="shoulder_link_color">
        <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/shoulder_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- type đổi continuous -> revolute (bản export mặc định continuous, không giới
       hạn góc; khớp thật của bạn có giới hạn -> phải revolute mới đảm bảo
       lower/upper được các tool tôn trọng). axis lệch trục sạch (không phải
       "1 0 0"), nên xác nhận lại với CAD xem đây là lệch thật hay nhiễu mate. -->
  <joint name="base_joint" type="revolute">
    <origin xyz="0.031381 -0.48621 0.64846" rpy="1.4637 1.364 1.4753" />
        <!-- <origin xyz="0.031381 -0.48621 0.64846" rpy="1.4637 1.364/1.744 1.4753" /> -->
    <parent link="base_link" />
    <child link="shoulder_link" />
    <axis xyz="0.99932 -0.031099 -0.019999" />
    <!-- effort/velocity giờ suy ra từ đúng 3 con số phần cứng, quy về PHÍA
         KHỚP (trục ra) chứ không phải phía rotor:
           1) GIM6010-8: 5Nm định mức / 11Nm stall tại trục ra hộp số nội bộ
              8:1, tức phía rotor là 0.625Nm định mức.
           2) controller.config.vel_limit = 20 rev/s phía rotor
              = 20*2*pi = 125.66 rad/s.
           3) gear_ratio TỔNG mỗi khớp (khai trong khối ros2_control bên dưới,
              cùng nguồn mà gim_arm_system.cpp đọc): base 8, shoulder 64
              (8 nội bộ x 8 hộp ngoài), elbow 8.
         Suy ra: effort = 0.625 * N, tức base/elbow 5Nm và shoulder 40Nm;
         velocity = 125.66 / N, tức base/elbow 15.708 rad/s và shoulder 1.963.
         Dùng mô-men ĐỊNH MỨC (liên tục), không dùng stall 11Nm/88Nm: stall
         chỉ có trong thời gian ngắn và bị giới hạn nhiệt, không nên để
         planner coi là dùng được liên tục trên thiết bị đeo vào người.
         CẦN XÁC NHẬN: vel_limit=20 rev/s là giá trị cấu hình của driver, nên
         đọc lại bằng odrivetool (axis0.controller.config.vel_limit) trên từng
         driver thật; nếu khác thì sửa lại theo công thức 125.66/N. -->
    <limit lower="-0.7121" upper="1.0226" effort="5" velocity="15.708" />
  </joint>

  <link name="upper_arm_link">
    <inertial>
      <origin xyz="-0.020736655172626 0.102615712569984 -0.0918424005027231" rpy="0 0 0" />
      <mass value="1.15563310050408" />
      <inertia
        ixx="0.0046453378861501"
        ixy="-0.000106201197109939"
        ixz="-0.000256625754245197"
        iyy="0.00528562874184763"
        iyz="-0.00041294658184148"
        izz="0.0010644214679654" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/upper_arm_link.STL" />
      </geometry>
      <material name="upper_arm_link_color">
        <color rgba="0.545098039215686 0 0.870588235294118 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/upper_arm_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <origin xyz="-0.049966 0.001555 0.00099995" rpy="-1.375708549 0.010247217 1.396947503" />
        <!-- <origin xyz="-0.049966 0.001555 0.00099995" rpy="-1.3842 -0.058173 1.7475" /> -->
    <parent link="shoulder_link" />
    <child link="upper_arm_link" />
    <axis xyz="0 -1 0" />
    <!-- gear_ratio 64 (8 nội bộ x 8 hộp ngoài): mô-men gấp 8 lần base/elbow
         nhưng tốc độ tối đa chỉ còn 1/8. Số cũ (effort 5, velocity 12.5) sai
         cả 2 chiều: khai thiếu 8 lần mô-men thật, và khai thừa 6.4 lần tốc độ
         mà khớp này không bao giờ đạt được. Xem giải thích ở base_joint. -->
    <limit lower="-0.2366" upper="1.3435" effort="40" velocity="1.963" />
  </joint>

  <link name="lower_arm_link">
    <inertial>
      <origin xyz="0.185270162663334 0.00970989472364725 0.0463325988746627" rpy="0 0 0" />
      <mass value="0.846776609767109" />
      <inertia
        ixx="0.000639693628361318"
        ixy="2.29941438911678E-05"
        ixz="0.000253970645035867"
        iyy="0.00160796485183614"
        iyz="1.83629192835509E-05"
        izz="0.00182026575035514" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/lower_arm_link.STL" />
      </geometry>
      <material name="lower_arm_link_color">
        <color rgba="1 0.509803921568627 0.196078431372549 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/lower_arm_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="elbow_joint" type="revolute">
    <origin xyz="-0.014232 0 -0.21358" rpy="1.570809721 1.469492654 -3.141575913" />
        <!-- <origin xyz="-0.014232 0 -0.21358" rpy="-1.5708 1.1931 0" /> -->
    <parent link="upper_arm_link" />
    <child link="lower_arm_link" />
    <axis xyz="0 0 -1" />
    <!-- gear_ratio 8 (chỉ hộp số nội bộ), giống base_joint. -->
    <limit lower="-0.2336" upper="1.7762" effort="5" velocity="15.708" />
  </joint>

<!-- param cho node_id + CAN interface + state velocity + gear_ratio + invert_direction -->
<ros2_control name="GimArmSystem" type="system">
  <hardware>
    <plugin>gim_arm_hardware/GimArmSystemHardware</plugin>
    <param name="can_interface">can0</param>
    <!-- Feedforward cho Set_Input_Pos (0x00C). Mặc định trong code là TẮT;
         bật ở đây để việc bật/tắt là một dòng NHÌN THẤY ĐƯỢC trong URDF, không
         phải hành vi ẩn trong plugin.
         - velocity_feedforward: điền Vel_FF = q̇_ref. Xoá sai số bám thường
           trực e = q̇/pos_gain của vòng P vị trí (nguồn trễ chính, KHÔNG mất đi
           khi đổi input_mode). Cần <command_interface name="velocity"/> bên
           dưới VÀ 'velocity' trong command_interfaces của controllers.yaml.
         - gravity_feedforward: điền Torque_FF = G(q_lệnh), tính bằng Pinocchio
           từ chính file URDF này.
         Đo trong mô phỏng (kinematics_test/compare_architectures.py), sai số
         bám đầu tay: 2.066mm -> 0.437mm (vel_ff) -> 0.266mm (thêm G(q)).
         TẮT NHANH khi thử trên tay thật: đổi true thành false, không cần build
         lại C++, chỉ cần colcon build gim_arm_description và chạy lại.
         Vẫn giữ nguyên control_mode=3 (vị trí): driver giữ vòng vị trí của nó,
         nên PC chết thì tay vẫn đứng, không rơi. -->
    <param name="velocity_feedforward">false</param>
    <param name="gravity_feedforward">true</param>

    <!-- ===== Chế độ MÔ-MEN (đường LQI) =====
         Chỉ bật khi controller claim interface 'effort'. Đường PID không đụng
         tới. torque_sign: quy ước dấu của FIRMWARE. Input_Torque dương làm
         encoder TĂNG (+1) hay GIẢM (-1). ĐO BẰNG cansend trước khi chạy vòng
         kín, xem RUNBOOK Phase 2. Đây KHÔNG phải invert_direction: cái đó bù
         chiều lắp motor và đã nằm trong directions_.
         effort_stale_cycles: forward_command_controller ghi lại giá trị cuối
         mãi mãi nếu lqi_node chết. 50 chu kỳ @100Hz = 0.5 s không đổi một bit
         nào thì plugin coi nguồn phát đã chết và tụt về bù trọng lực. -->
    <param name="torque_sign">-1</param>
    <param name="effort_stale_cycles">50</param>

    <!-- ===== BẢNG CHẾ ĐỘ =====
         Plugin viết sẵn 4 chế độ; chọn chế độ nào là do BỘ command_interface mà
         controller đang claim, KHÔNG phải do sửa C++:
           VI TRI  <- claim 'position' [+ 'velocity' làm Vel_FF]  (JTC — đang dùng)
           VAN TOC <- claim CHỈ 'velocity'                        (0x00D)
           MO-MEN  <- claim 'effort'                              (0x00E — LQI)
           MIT     <- claim 'position' + 'effort' cùng lúc        (0x008 impedance)
         Đổi chế độ = switch_controllers, không cần build lại plugin.
         Plugin in đúng bảng này ra log lúc khởi động, kèm trạng thái từng dòng.

         VAN TOC và MIT CHƯA ĐƯỢC KIỂM CHỨNG TRÊN TAY THẬT. Đọc kỹ trước khi bật:
         - VAN TOC: driver KHÔNG giữ vị trí. Nguồn phát chết -> watchdog
           (effort_stale_cycles) tụt lệnh về 0 rad/s sau 0.5 s. Trần vận tốc khai
           riêng từng khớp: <param name="max_velocity_joint_rad_s">, mặc định 1.0.
           Layout trường Torque_FF của frame 0x00D chưa đo lại bằng candump —
           kiểm tra trước khi dùng kèm gravity_feedforward.
         - MIT: mặc định TẮT. Bỏ chú thích dòng dưới để mở. Cần khai thêm
           <param name="mit_kp"> / <param name="mit_kd"> trong TỪNG <joint>
           (đơn vị phía TRỤC RA DRIVER: Nm/rad và Nm*s/rad); để 0 thì MIT thoái
           hoá thành mô-men thuần và driver không giữ tay nữa.
           Khi TẮT, claim đồng thời position+effort vẫn bị TỪ CHỐI y như trước. -->
    <!-- <param name="enable_mit_mode">true</param> -->
  </hardware>
  <joint name="base_joint">
    <command_interface name="position"/>
    <command_interface name="velocity"/>
    <!-- effort: đường vào của LQI. Thêm interface này KHÔNG ảnh hưởng đường
         PID vì JTC chỉ claim position+velocity, interface thừa nó không đụng. -->
    <command_interface name="effort"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
    <param name="can_node_id">0</param>
    <!-- Trần cứng mô-men PHÍA KHỚP, riêng khớp này. Lớp bảo vệ cuối, độc lập
         với tau_scale bên lqi_node. cần 1.58 (ff đỉnh 0.44 + phản hồi 1.13) Nm;
         để 2.5 = ~1.5 lần dư địa. Trần URDF <limit effort> là 5 Nm. -->
    <param name="max_torque_joint_nm">2.5</param>
    <param name="invert_direction">true</param>       <!-- them -->
  </joint>
  <joint name="shoulder_joint">
    <command_interface name="position"/>
    <command_interface name="velocity"/>
    <!-- effort: đường vào của LQI. Thêm interface này KHÔNG ảnh hưởng đường
         PID vì JTC chỉ claim position+velocity, interface thừa nó không đụng. -->
    <command_interface name="effort"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
    <param name="can_node_id">1</param>
    <!-- Trần cứng mô-men PHÍA KHỚP, riêng khớp này. Lớp bảo vệ cuối, độc lập
         với tau_scale bên lqi_node. cần 4.99 (ff đỉnh 3.64 + phản hồi 1.35) Nm;
         để 7.5 = ~1.5 lần dư địa. Trần URDF <limit effort> là 40 Nm. -->
    <param name="max_torque_joint_nm">7.5</param>
    <param name="gear_ratio">64.0</param>
  </joint>
  <joint name="elbow_joint">
    <command_interface name="position"/>
    <command_interface name="velocity"/>
    <!-- effort: đường vào của LQI. Thêm interface này KHÔNG ảnh hưởng đường
         PID vì JTC chỉ claim position+velocity, interface thừa nó không đụng. -->
    <command_interface name="effort"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
    <param name="can_node_id">2</param>
    <!-- Trần cứng mô-men PHÍA KHỚP, riêng khớp này. Lớp bảo vệ cuối, độc lập
         với tau_scale bên lqi_node. cần 1.80 (ff đỉnh 1.51 + phản hồi 0.29) Nm;
         để 3.0 = ~1.5 lần dư địa. Trần URDF <limit effort> là 5 Nm. -->
    <param name="max_torque_joint_nm">3.0</param>
    <param name="invert_direction">true</param>
  </joint>
</ros2_control>

</robot>