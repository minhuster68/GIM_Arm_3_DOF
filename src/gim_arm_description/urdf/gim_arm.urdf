<?xml version="1.0"?>
<robot name="gim_arm">

  <!-- Dummy root link to satisfy KDL (added) -->
  <link name="base_footprint"/>

  <!-- Tạo mặt đất ảo -->
  <link name="world"/>

  <!-- Bắt vít gốc của cánh tay xuống mặt đất ảo -->
  <joint name="world_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Fixed joint from dummy root to base_link (added) -->
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0.083 0 0"/>
    <!-- <origin xyz="0 0 0" rpy="0.1 0 0"/> -->
  </joint>

  <link name="base_link">
    <inertial>
      <!-- ĐỒNG BỘ 27/08/2026 theo matlab (robot urdf_ver2, export SolidWorks
           23/08/2026). KHÔNG ảnh hưởng động lực học: base_link là link GỐC và bị
           hàn cứng xuống world, nên Pinocchio/MuJoCo bỏ qua quán tính của nó.
           Vẫn đổi vì bản cũ TỰ MÂU THUẪN với chính mesh của nó: tâm khối khai
           (0.27344, 0.27939, 0.51015) so với tâm hình học đo được từ
           base_link.STL (0.27325, -0.50967, 0.27946) là lệch đúng một phép quay
           +90 độ quanh trục x (kiểm cả 6 phần tử ma trận quán tính: iyy<->izz,
           ixy<->ixz, iyz đổi dấu). Tức khối <inertial> cũ đến từ một lần export
           có khung base_link khác, không phải từ mesh đang nằm trong repo.
           Bản matlab khớp tâm hình học tới 0.5 mm. -->
      <origin xyz="0.269439843183932 -0.510305429832032 0.28864640978465" rpy="0 0 0" />
      <mass value="6.78071383810195" />
      <inertia
        ixx="0.292982115231117"
        ixy="-1.48741255187693E-05"
        ixz="2.42892432158613E-05"
        iyy="0.315548948805223"
        iyz="0.0223532567301581"
        izz="0.157616658426692" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/base_link.STL" />
      </geometry>
      <material name="base_link_color">
        <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <link name="shoulder_link">
    <inertial>
      <!-- ĐỒNG BỘ 27/08/2026 theo matlab. ĐÂY LÀ THAY ĐỔI ĐỘNG LỰC HỌC LỚN
           NHẤT của lần sync này: khối lượng 190.7 g -> 78.5 g (2.43 lần).
           Lệch THẬT, không phải khác hệ quy chiếu -- đã đo thể tích trực tiếp từ
           2 file STL: 190.58 cm3 (bản cũ, 24390 tam giác) so với 78.50 cm3 (bản
           matlab, 3418 tam giác), đúng tỉ lệ 2.428 bằng tỉ lệ khối lượng. Bản cũ
           dài hơn 4 cm theo trục x. Mỗi bản đều TỰ KHỚP với mesh của nó (tâm
           khối lệch tâm hình học < 0.1 mm ở cả hai), nên đây là hai PHIÊN BẢN CAD
           khác nhau của cùng chi tiết, không phải lỗi quy chiếu.
           CẢNH BÁO: cả hai bản đều ra khối lượng riêng đúng 1.000 g/cm3
           (78.544/78.50 và 190.733/190.58) -- dấu hiệu SolidWorks đang dùng vật
           liệu mặc định (nước) cho chi tiết này, ở CẢ HAI lần export. Nên khối
           lượng shoulder_link là số YẾU NHẤT trong URDF, cần cân thật rồi khai
           lại; các link khác không có dấu hiệu này (upper_arm 1.466 g/cm3,
           lower_arm 1.318 g/cm3, base 1.016 g/cm3). -->
      <origin xyz="-0.12809 -0.0029768 -0.047288" rpy="0 0 0" />
      <mass value="0.078544" />
      <inertia
        ixx="0.00012089"
        ixy="1.2041E-05"
        ixz="7.2401E-05"
        iyy="0.0001867"
        iyz="-1.3727E-05"
        izz="0.00010536" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/shoulder_link.STL" />
      </geometry>
      <material name="shoulder_link_color">
        <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/shoulder_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- type đổi continuous -> revolute (bản export mặc định continuous, không giới
       hạn góc; khớp thật của bạn có giới hạn -> phải revolute mới đảm bảo
       lower/upper được các tool tôn trọng). axis lệch trục sạch (không phải
       "1 0 0"), nên xác nhận lại với CAD xem đây là lệch thật hay nhiễu mate. -->
  <joint name="base_joint" type="revolute">
    <origin xyz="0.031381 -0.48621 0.64846" rpy="1.4637 1.364 1.4753" />
        <!-- <origin xyz="0.031381 -0.48621 0.64846" rpy="1.4637 1.364/1.744 1.4753" /> -->
    <parent link="base_link" />
    <child link="shoulder_link" />
    <axis xyz="0.99932 -0.031099 -0.019999" />
    <!-- effort/velocity giờ suy ra từ đúng 3 con số phần cứng, quy về PHÍA
         KHỚP (trục ra) chứ không phải phía rotor:
           1) GIM6010-8: 5Nm định mức / 11Nm stall tại trục ra hộp số nội bộ
              8:1, tức phía rotor là 0.625Nm định mức.
           2) controller.config.vel_limit = 20 rev/s phía rotor
              = 20*2*pi = 125.66 rad/s.
           3) gear_ratio TỔNG mỗi khớp (khai trong khối ros2_control bên dưới,
              cùng nguồn mà gim_arm_system.cpp đọc): base 8, shoulder 64
              (8 nội bộ x 8 hộp ngoài), elbow 8.
         Suy ra: effort = 0.625 * N, tức base/elbow 5Nm và shoulder 40Nm;
         velocity = 125.66 / N, tức base/elbow 15.708 rad/s và shoulder 1.963.
         Dùng mô-men ĐỊNH MỨC (liên tục), không dùng stall 11Nm/88Nm: stall
         chỉ có trong thời gian ngắn và bị giới hạn nhiệt, không nên để
         planner coi là dùng được liên tục trên thiết bị đeo vào người.
         CẦN XÁC NHẬN: vel_limit=20 rev/s là giá trị cấu hình của driver, nên
         đọc lại bằng odrivetool (axis0.controller.config.vel_limit) trên từng
         driver thật; nếu khác thì sửa lại theo công thức 125.66/N. -->
    <limit lower="-0.7121" upper="1.0226" effort="5" velocity="15.708" />
  </joint>

  <link name="upper_arm_link">
    <inertial>
      <!-- 27/08/2026 -- GIỮ NGUYÊN THEO ROS, KHÔNG lấy theo matlab. Đây là chỗ
           DUY NHẤT lần sync này đi khác kế hoạch ban đầu, vì có bằng chứng số:

           <origin> của <inertial> là TÂM KHỐI, với chi tiết đặc thì nó phải nằm
           rất gần TÂM HÌNH HỌC của mesh cùng khung. Đo trực tiếp từ 2 file STL:
                            |COM - tâm hình học|    COM có trong hộp bao mesh?
             bản ROS                   8.5 mm                 CÓ
             bản matlab               36.9 mm                 CÓ
           Khối lượng riêng của cả 2 bản GIỐNG NHAU tới 3 chữ số (1.466 g/cm3) và
           thể tích mesh trùng tới 0.01 cm3 -> chắc chắn cùng chi tiết, cùng vật
           liệu, nên TÂM KHỐI VẬT LÝ phải là một điểm. Hai file khai hai điểm
           khác nhau (cách nhau 55 mm khi quy về khung world ở cùng tư thế), nên
           đúng một trong hai sai; bản khớp mesh tốt hơn 4.3 lần là bản ROS.
           Xem thêm lower_arm_link -- ở đó bản matlab SAI RÕ RÀNG (COM nằm NGOÀI
           hộp bao mesh), cùng một kiểu lỗi, nên không phải trùng hợp.

           KHÔNG cần quay lại theo khung mới: đã kiểm bằng số rằng hai URDF chỉ
           lệch nhau ĐIỂM 0 của shoulder/elbow (FK_moi(q) == FK_cu(q+delta) với
           delta = [0, 0.357, 0.479] rad, sai số 5e-10) -- tức khung link là MỘT,
           chỉ tham số hoá khác. Nên <inertial> chép sang nguyên vẹn là đúng.

           Bản matlab, giữ lại để đối chiếu nếu sau này cân/đo lại thấy nó đúng:
             <origin xyz="-0.071952 0.095449 -0.072076" rpy="0 0 0" />
             <mass value="1.1556" />
             ixx 0.0040135  ixy -0.00040368  ixz -0.00142
             iyy 0.0052121  iyz -0.00043608  izz 0.0017698           -->
      <origin xyz="-0.020736655172626 0.102615712569984 -0.0918424005027231" rpy="0 0 0" />
      <mass value="1.15563310050408" />
      <inertia
        ixx="0.0046453378861501"
        ixy="-0.000106201197109939"
        ixz="-0.000256625754245197"
        iyy="0.00528562874184763"
        iyz="-0.00041294658184148"
        izz="0.0010644214679654" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/upper_arm_link.STL" />
      </geometry>
      <material name="upper_arm_link_color">
        <color rgba="0.545098039215686 0 0.870588235294118 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/upper_arm_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <!-- ĐỒNG BỘ 27/08/2026: rpy lấy theo matlab, tức HOÀN NGUYÊN đợt sửa tay
         12-13/08. Bằng chứng đây là hoàn nguyên chứ không phải thay đổi mới:
         src/gim_arm_mujoco/gim_arm_mujoco.urdf (bản đóng băng TRƯỚC 12/8) đang
         khai đúng rpy này. Giá trị sửa tay bị bỏ giữ lại trong comment dưới.
         axis GIỮ THEO ROS (xem <axis> bên dưới), KHÔNG lấy theo matlab. -->
    <origin xyz="-0.049966 0.001555 0.00099995" rpy="-1.3842 -0.058173 1.7475" />
        <!-- bản sửa tay 12-13/08, ĐÃ BỎ:
             <origin xyz="-0.049966 0.001555 0.00099995" rpy="-1.375708549 0.010247217 1.396947503" /> -->
    <parent link="shoulder_link" />
    <child link="upper_arm_link" />
    <axis xyz="0 -1 0" />
    <!-- gear_ratio 64 (8 nội bộ x 8 hộp ngoài): mô-men gấp 8 lần base/elbow
         nhưng tốc độ tối đa chỉ còn 1/8. Số cũ (effort 5, velocity 12.5) sai
         cả 2 chiều: khai thiếu 8 lần mô-men thật, và khai thừa 6.4 lần tốc độ
         mà khớp này không bao giờ đạt được. Xem giải thích ở base_joint. -->
    <limit lower="-0.2366" upper="1.3435" effort="40" velocity="1.963" />
  </joint>

  <link name="lower_arm_link">
    <inertial>
      <!-- 27/08/2026 -- GIỮ NGUYÊN THEO ROS, KHÔNG lấy theo matlab. Bản matlab
           SAI, không phải "khác hệ quy chiếu":
             . tâm khối matlab (0.053586, 0.21808, 0.029711) cách TÂM HÌNH HỌC
               của chính mesh matlab 243.9 mm, và NẰM NGOÀI hộp bao mesh
               (46 x 17 x 21 cm). Tâm khối của một chi tiết đặc không thể nằm
               ngoài chi tiết đó.
             . bản ROS: cách tâm hình học 19.7 mm, nằm trong hộp bao -> hợp lý.
             . cả 2 bản cùng khối lượng riêng 1.318 g/cm3 và thể tích mesh lệch
               0.03 cm3 -> cùng chi tiết, cùng vật liệu.
           Đây là link ẢNH HƯỞNG G(q) MẠNH NHẤT: nếu lấy theo matlab thì tâm khối
           cẳng tay dịch 247 mm trong khung world, làm G lệch tới 2.03 Nm ở CẢ
           shoulder VÀ elbow -- cỡ 84% |G| đỉnh dọc quỹ đạo. Tức lấy bừa theo
           matlab là phá đúng cái mô hình trọng lực đã hiệu chỉnh bằng tay.

           Bản matlab, giữ lại để đối chiếu:
             <origin xyz="0.053586 0.21808 0.029711" rpy="0 0 0" />
             <mass value="0.84674" />
             ixx 0.0011598  ixy -0.00049096  ixz 0.00016408
             iyy 0.0011338  iyz 0.00023849   izz 0.0017743            -->
      <origin xyz="0.185270162663334 0.00970989472364725 0.0463325988746627" rpy="0 0 0" />
      <mass value="0.846776609767109" />
      <inertia
        ixx="0.000639693628361318"
        ixy="2.29941438911678E-05"
        ixz="0.000253970645035867"
        iyy="0.00160796485183614"
        iyz="1.83629192835509E-05"
        izz="0.00182026575035514" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/lower_arm_link.STL" />
      </geometry>
      <material name="lower_arm_link_color">
        <color rgba="1 0.509803921568627 0.196078431372549 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://gim_arm_description/meshes/lower_arm_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="elbow_joint" type="revolute">
    <!-- ĐỒNG BỘ 27/08/2026: rpy lấy theo matlab = hoàn nguyên đợt sửa tay
         12-13/08, xem chú thích ở shoulder_joint. -->
    <origin xyz="-0.014232 0 -0.21358" rpy="-1.5708 1.1931 0" />
        <!-- bản sửa tay 12-13/08, ĐÃ BỎ:
             <origin xyz="-0.014232 0 -0.21358" rpy="1.570809721 1.469492654 -3.141575913" /> -->
    <parent link="upper_arm_link" />
    <child link="lower_arm_link" />
    <axis xyz="0 0 -1" />
    <!-- gear_ratio 8 (chỉ hộp số nội bộ), giống base_joint. -->
    <limit lower="-0.2336" upper="1.7762" effort="5" velocity="15.708" />
  </joint>

<!-- param cho node_id + CAN interface + state velocity + gear_ratio + invert_direction -->
<ros2_control name="GimArmSystem" type="system">
  <hardware>
    <plugin>gim_arm_hardware/GimArmSystemHardware</plugin>
    <param name="can_interface">can0</param>

    <!-- Feedforward cho Set_Input_Pos (0x00C), chỉ có tác dụng ở CHẾ ĐỘ VỊ TRÍ.
         Phải để false khi lấy số nền PID, vì 3 lần chạy nền đã đo với false. -->
    <param name="velocity_feedforward">false</param>
    <param name="gravity_feedforward">false</param>

    <!-- ================= CHẾ ĐỘ MÔ-MEN (đường LQI) =================
         Chỉ bật khi controller claim interface 'effort'. Đường PID không đụng tới.

         QUY ĐỔI MÔ-MEN, giải thích một lần ở đây, khai số riêng trong từng joint:

             tau_driver = torque_sign * tau_khop / torque_gear_ratio

         torque_gear_ratio = gear NGOÀI (tổng / 8 nội bộ), tức các trường mô-men
         trên CAN ở PHÍA TRỤC RA của hộp số nội bộ 8:1. ĐÃ ĐO CẢ HAI CHIỀU:
           . dùng gear TỔNG (phía rotor, theo chú thích manual): mô-men yếu đi 8
             lần, tay rơi tự do, base tụt 32.5 độ trong 2.3 giây
           . dùng gear NGOÀI: khớp phép thử treo 1 kg trong 3-6%
         Nên chú thích manual "0x00E phía rotor" KHÔNG đúng với firmware này.
         Lý do vật lý: firmware nạp torque_constant = 0.669 = 8.27/kv với
         kv = 12.3 rpm/V, mà con số đó đi cùng bộ rated speed 120 rpm, tức phía
         trục ra. Mọi trường mô-men qua CAN dùng chung hằng số đó.

         torque_sign KHÔNG khai ở đây: nó KHÁC NHAU giữa các khớp, đo trực tiếp
         từ chiều chuyển động thật so với chiều trọng lực.

         effort_stale_cycles: forward_command_controller ghi lại giá trị cuối mãi
         mãi nếu lqi_node chết. 50 chu kỳ @100Hz = 0.5 s không đổi một bit nào thì
         plugin coi nguồn phát đã chết và tụt về bù trọng lực. -->
    <param name="effort_stale_cycles">50</param>

    <!-- ================= TRẠNG THÁI HIỆU CHỈNH =================
             khớp        torque_sign   gravity_scale   ghi chú
             base            -1            2.0?        ĐANG ĐO LẠI, xem dưới
             shoulder        +1            1.1         đã chốt
             elbow           -1            0.8         đã chốt

         Đặt bằng:  ros2 param set /lqi_node gravity_scale "[a, 1.1, 0.8]"

         ĐANG CÔ LẬP base_joint: shoulder và elbow bị khoá ở chế độ vị trí bằng
         torque_mode_enable = false. Xong thì xoá hai dòng đó để cả 3 cùng chạy. -->

    <!-- ================= BẢNG CHẾ ĐỘ =================
         Chọn chế độ nào là do BỘ command_interface mà controller đang claim:
           VI TRI  &lt;- 'position' [+ 'velocity' làm Vel_FF]   (JTC, đường PID)
           VAN TOC &lt;- CHỈ 'velocity'                          (0x00D)
           MO-MEN  &lt;- 'effort'                                (0x00E, LQI)
           MIT     &lt;- 'position' + 'effort' cùng lúc           (0x008 impedance)
         Đổi chế độ = switch_controllers, không cần build lại plugin.
         VAN TOC và MIT CHƯA KIỂM CHỨNG TRÊN TAY THẬT. MIT mặc định TẮT. -->
    <!-- <param name="enable_mit_mode">true</param> -->
  </hardware>

  <joint name="base_joint">
    <command_interface name="position"/>
    <command_interface name="velocity"/>
    <command_interface name="effort"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
    <param name="can_node_id">0</param>
    <param name="invert_direction">true</param>

    <!-- torque_sign = -1: đo được khớp này rơi 0.43 rad với dấu -1, và 0.77 tới
         1.00 rad với dấu +1. Rơi ÍT HƠN với -1 nên -1 là chiều đúng.
         max_torque_joint_nm 1.5: |G| đỉnh của khớp này 1.181 Nm, dư địa 27%. -->
    <param name="torque_sign">-1</param>
    <param name="torque_gear_ratio">1.0</param>
    <param name="max_torque_joint_nm">1.5</param>

    <!-- KHÔNG khai torque_mode_enable  =  mặc định true  =  ĐANG THỬ khớp này.

         VÌ SAO ĐO LẠI: alpha = 2.0 tìm được lần trước là con số kém tin nhất
         trong ba khớp, vì ba lý do:
           . |G_base| chỉ 0.61 Nm ở tư thế thử, nhỏ nhất trong ba khớp, nên
             "khoảng lơ lửng" do ma sát tĩnh rộng nhất: +/- f/G, tới +/-49%
             nếu ma sát 0.3 Nm. 2.0 có thể đang ở MÉP khoảng chứ không phải giữa.
           . 2.0 lệch hơn hẳn hai khớp kia (1.1 và 0.8). Nếu đây là hệ số quy đổi
             của đường truyền thì ba khớp phải gần nhau, vì cùng loại driver,
             cùng firmware.
           . mô-men đo được ở khớp này nhiễu 293% giá trị trung bình.

         CÁCH ĐO ĐÚNG: quét tìm CẢ HAI MÉP, không dừng ở giá trị đầu tiên thấy
         đứng yên.
             alpha_duoi = giá trị CUỐI CÙNG còn rơi
             alpha_tren = giá trị ĐẦU TIÊN bắt đầu bật lên
             alpha_chon = (alpha_duoi + alpha_tren) / 2
         Bề rộng khoảng cho luôn ước lượng ma sát: f = G * (alpha_tren - alpha_duoi)/2

         SAU ĐÓ LẶP Ở TƯ THẾ KHÁC. Hệ số quy đổi là tính chất đường truyền nên
         KHÔNG đổi theo tư thế; sai mô hình thì đổi.
             alpha giống nhau  -> hệ số quy đổi, cách làm hiện tại đúng
             alpha khác rõ     -> mô hình G_base sai, phải sửa <axis>/<origin rpy>
         Trường hợp sau thì hiệu chỉnh bằng alpha chỉ là vá tạm và sẽ sai ở
         những tư thế khác trên quỹ đạo. -->
  </joint>

  <joint name="shoulder_joint">
    <command_interface name="position"/>
    <command_interface name="velocity"/>
    <command_interface name="effort"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
    <param name="can_node_id">1</param>
    <param name="gear_ratio">64.0</param>

    <!-- torque_sign = +1: ĐÃ CHỐT. Với dấu +1 khớp này DỪNG ở q = 0.264, nằm
         TRONG dải hợp lệ, giữ với biên độ 2e-05 rad. Đó là lơ lửng thật, không
         phải tựa cữ. Với dấu -1 nó rơi 0.72 rad.
         gravity_scale = 1.1, tức c = 0.909, mô hình thiếu 9%.
         max_torque_joint_nm 5.0: |G| đỉnh 4.102 Nm, dư địa 22%. -->
    <param name="torque_sign">1</param>
    <param name="torque_gear_ratio">8.0</param>
    <param name="max_torque_joint_nm">5.0</param>

    <!-- KHOÁ để cô lập base_joint. Khớp này ở lại chế độ vị trí ngay cả khi
         controller claim 'effort'; driver giữ cứng nó tại chỗ đang đứng.
         XOÁ DÒNG NÀY khi đã đo xong base và muốn chạy cả 3 khớp. -->
    <!-- <param name="torque_mode_enable">false</param> -->
  </joint>

  <joint name="elbow_joint">
    <command_interface name="position"/>
    <command_interface name="velocity"/>
    <command_interface name="effort"/>
    <state_interface name="position"/>
    <state_interface name="velocity"/>
    <param name="can_node_id">2</param>
    <param name="invert_direction">true</param>

    <!-- torque_sign = -1: với -1 khớp này bị ĐẨY NGƯỢC trọng lực (+1.31 rồi
         +0.56 rad), với +1 thì RƠI (-1.79 rad). G_elbow dương suốt cả đường đi
         nên buông ra phải GIẢM q. Suy ra -1 đúng chiều nhưng hơi mạnh.
         gravity_scale = 0.8, tức c = 1.25, mô hình thừa 25%.
         max_torque_joint_nm 2.0: |G| đỉnh 1.518 Nm, dư địa 32%. -->
    <param name="torque_sign">-1</param>
    <param name="torque_gear_ratio">1.0</param>
    <param name="max_torque_joint_nm">2.0</param>

    <!-- KHOÁ để cô lập base_joint. XOÁ DÒNG NÀY khi đã đo xong base. -->
    <!-- <param name="torque_mode_enable">false</param> -->
  </joint>
</ros2_control>

</robot>